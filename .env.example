# Copy to .env and fill in. See README.md for where each value comes from.

# ── GitHub App ──────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_OWNER=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
"
GITHUB_WEBHOOK_SECRET=
# Legacy PAT fallback only (used if GitHub App installation token cannot be minted)
GITHUB_TOKEN=

# ── LLM (Groq — primary reasoning provider) ────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b



# ── Embeddings (RAG) ────────────────────────────────────────────────────
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Supabase (Postgres source of truth + pgvector + Storage) ───────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Redis (queue / job coordination) ────────────────────────────────────
REDIS_URL=redis://default:password@host:port

# ── Discord (human approval) ────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_RESUME_CHANNEL_ID=
DISCORD_LINKEDIN_CHANNEL_ID=
DISCORD_CALLBACK_SHARED_SECRET=
APP_BASE_URL=http://localhost:8000

# ── LinkedIn ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Pollinations (LinkedIn image generation) ────────────────────────────
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_API_TOKEN=

# ── Remote LaTeX compiler (YtoTech LaTeX-On-HTTP) ───────────────────────
LATEX_COMPILER_PROVIDER=ytotech
LATEX_COMPILER_URL=https://latex.ytotech.com/builds/sync
LATEX_COMPILER_API_TOKEN=

# ── Portfolio site revalidation ─────────────────────────────────────────
PORTFOLIO_REVALIDATE_URL=https://supriobiswas.me/api/revalidate
REVALIDATE_SECRET=

# ── Misc ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
